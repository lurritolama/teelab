---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, bySlug } from '../../data/products.js';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = bySlug(slug);
---
<BaseLayout title={`${p.name} — TeeLab`} description={p.desc}>
  <div class="crumbs"><a href="/shop">Shop</a> / {p.name}</div>
  <section class="pd">
    <figure class="pd-media">
      <img src="/placeholder-product.svg" alt={`Produktfoto ${p.name} folgt`} />
    </figure>
    <div>
      <div class="tag">{p.tag}</div>
      <h1>{p.name}</h1>
      <div class="spec">
        <div><div class="n">{p.length}</div>Länge</div>
        <div><div class="n">{p.head}</div>Kopf</div>
        <div><div class="n">{p.unit}</div>Menge</div>
      </div>
      <div class="price">{p.price} · {p.unit}</div>
      <p class="desc">{p.desc}</p>
      <div class="cta">
        <button class="btn primary" id="addToCart" data-id={p.id} data-slug={p.slug} data-titel={p.name} data-preis={p.priceRappen}>In den Warenkorb</button>
        <a class="btn ghost" href="/konfigurator">Selbst gestalten</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { hinzufuegen } from '../../lib/cart.js';
  const b = document.getElementById('addToCart');
  b?.addEventListener('click', () => {
    hinzufuegen({ id: b.dataset.id, slug: b.dataset.slug, titel: b.dataset.titel, preisRappen: Number(b.dataset.preis) });
    const alt = b.textContent; b.textContent = '✓ Hinzugefügt';
    setTimeout(() => { b.textContent = alt; }, 1400);
  });
</script>
